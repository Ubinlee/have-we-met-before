rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function pairDocument(pairId) {
      return get(/databases/$(database)/documents/pairs/$(pairId));
    }

    function isPairMember(pairId) {
      return signedIn()
        && request.auth.uid in pairDocument(pairId).data.memberIds;
    }

    // 연결을 해제한(ended) 상대는 멤버·방문 기록·결과를 더 이상 읽거나 쓸 수 없습니다.
    // 초대를 만든 사람은 대기(waiting) 중에도 자기 멤버 문서를 준비합니다.
    function isOpenPairMember(pairId) {
      let pair = pairDocument(pairId).data;
      return signedIn()
        && request.auth.uid in pair.memberIds
        && pair.status in ['waiting', 'active'];
    }

    function validUserProfile(data) {
      return data.keys().hasAll(['nickname', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['nickname', 'createdAt', 'updatedAt'])
        && data.nickname is string
        && data.nickname.size() > 0
        && data.nickname.size() <= 20
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function validPair(data) {
      return data.keys().hasAll([
          'creatorId',
          'memberIds',
          'status',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'creatorId',
          'creatorNickname',
          'memberIds',
          'status',
          'expiresAt',
          'firstMetAt',
          'firstMetStatus',
          'firstMetProposedBy',
          'firstMetConfirmedBy',
          'createdAt',
          'updatedAt'
        ])
        && data.creatorId is string
        && (!('creatorNickname' in data)
          || (data.creatorNickname is string
            && data.creatorNickname.size() > 0
            && data.creatorNickname.size() <= 12))
        && (!('expiresAt' in data) || data.expiresAt is timestamp)
        && data.memberIds is list
        && data.memberIds.size() >= 1
        && data.memberIds.size() <= 2
        && data.status in ['waiting', 'active', 'ended']
        && (!('firstMetAt' in data) || data.firstMetAt is timestamp)
        && (!('firstMetStatus' in data)
          || data.firstMetStatus in ['pending', 'confirmed'])
        && (!('firstMetProposedBy' in data)
          || data.firstMetProposedBy in data.memberIds)
        && (!('firstMetConfirmedBy' in data)
          || (data.firstMetConfirmedBy is list
            && data.firstMetConfirmedBy.size() >= 1
            && data.firstMetConfirmedBy.size() <= 2))
        && (!('firstMetStatus' in data)
          || (('firstMetAt' in data)
            && ('firstMetProposedBy' in data)
            && ('firstMetConfirmedBy' in data)
            && data.firstMetConfirmedBy.hasAll([data.firstMetProposedBy])
            && (data.firstMetStatus == 'pending'
              || data.firstMetConfirmedBy.hasAll(data.memberIds))))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isInviteAcceptance() {
      return signedIn()
        && resource.data.status == 'waiting'
        && resource.data.memberIds.size() == 1
        && !(request.auth.uid in resource.data.memberIds)
        && request.resource.data.status == 'active'
        && request.resource.data.memberIds.size() == 2
        && request.resource.data.memberIds.hasAll(resource.data.memberIds)
        && request.resource.data.memberIds.hasAll([request.auth.uid])
        && request.resource.data.creatorId == resource.data.creatorId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['memberIds', 'status', 'updatedAt'])
        && validPair(request.resource.data);
    }

    // 상태는 그대로 두거나 waiting/active → ended로만 바꿀 수 있습니다.
    // 종료된 연결을 다시 active로 되살려 중복 연결을 만드는 것을 막습니다.
    function isAllowedStatusChange() {
      return request.resource.data.status == resource.data.status
        || (resource.data.status in ['waiting', 'active']
          && request.resource.data.status == 'ended');
    }

    function isMemberPairUpdate(pairId) {
      return isPairMember(pairId)
        && isAllowedStatusChange()
        && request.resource.data.creatorId == resource.data.creatorId
        && request.resource.data.memberIds == resource.data.memberIds
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([
            'status',
            'firstMetAt',
            'firstMetStatus',
            'firstMetProposedBy',
            'firstMetConfirmedBy',
            'updatedAt'
          ])
        && validPair(request.resource.data);
    }

    function validPairMember(data) {
      return data.keys().hasAll([
          'nickname',
          'analysisStatus',
          'recordCount',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'nickname',
          'analysisStatus',
          'recordCount',
          'recordSchemaVersion',
          'updatedAt'
        ])
        && data.nickname is string
        && data.nickname.size() > 0
        && data.nickname.size() <= 20
        && data.analysisStatus in ['notStarted', 'analyzing', 'ready', 'failed']
        && data.recordCount is int
        && data.recordCount >= 0
        && (!('recordSchemaVersion' in data)
          || data.recordSchemaVersion in [1, 2, 3])
        && data.updatedAt is timestamp;
    }

    function validSharedVisit(data) {
      return data.keys().hasAll([
          'timeBucketIndex',
          'latitudeCell',
          'longitudeCell',
          'schemaVersion'
        ])
        && data.keys().hasOnly([
          'timeBucketIndex',
          'latitudeCell',
          'longitudeCell',
          'schemaVersion'
        ])
        && data.timeBucketIndex is int
        && data.timeBucketIndex >= 0
        && data.latitudeCell is int
        && data.latitudeCell >= -45000
        && data.latitudeCell <= 45000
        && data.longitudeCell is int
        && data.longitudeCell >= -90000
        && data.longitudeCell <= 90000
        && data.schemaVersion in [1, 2, 3];
    }

    function validMatchResult(data) {
      return data.keys().hasAll([
          'score',
          'intersectionDayCount',
          'rankedIntersections',
          'generatedBy',
          'createdAt',
          'schemaVersion'
        ])
        && data.keys().hasOnly([
          'score',
          'intersectionDayCount',
          'closestLevel',
          'closestTimeBucketIndex',
          'closestLatitudeCell',
          'closestLongitudeCell',
          'rankedIntersections',
          'generatedBy',
          'createdAt',
          'schemaVersion'
        ])
        && data.score is int
        && data.score >= 0
        && data.score <= 100
        && data.intersectionDayCount is int
        && data.intersectionDayCount >= 0
        && data.rankedIntersections is list
        && data.rankedIntersections.size() <= 3
        && (data.rankedIntersections.size() < 1
          || validStoredIntersection(data.rankedIntersections[0]))
        && (data.rankedIntersections.size() < 2
          || validStoredIntersection(data.rankedIntersections[1]))
        && (data.rankedIntersections.size() < 3
          || validStoredIntersection(data.rankedIntersections[2]))
        && (!('closestLevel' in data)
          || data.closestLevel in [1, 2, 3])
        && (!('closestTimeBucketIndex' in data)
          || data.closestTimeBucketIndex is int)
        && (!('closestLatitudeCell' in data)
          || data.closestLatitudeCell is int)
        && (!('closestLongitudeCell' in data)
          || data.closestLongitudeCell is int)
        && data.generatedBy == request.auth.uid
        && data.createdAt is timestamp
        && data.schemaVersion in [1, 2, 3, 4];
    }

    function validStoredIntersection(data) {
      return data.keys().hasAll([
          'id',
          'firstRecordID',
          'secondRecordID',
          'firstCapturedAt',
          'secondCapturedAt',
          'strength',
          'distanceMeters',
          'timeDifference',
          'approximateLatitude',
          'approximateLongitude'
        ])
        && data.keys().hasOnly([
          'id',
          'firstRecordID',
          'secondRecordID',
          'firstCapturedAt',
          'secondCapturedAt',
          'strength',
          'distanceMeters',
          'timeDifference',
          'approximateLatitude',
          'approximateLongitude'
        ])
        && data.id is string
        && data.firstRecordID is string
        && data.secondRecordID is string
        && data.firstCapturedAt is timestamp
        && data.secondCapturedAt is timestamp
        && data.strength in [1, 2, 3]
        && data.distanceMeters is number
        && data.distanceMeters >= 0
        && data.timeDifference is number
        && data.timeDifference >= 0
        && data.approximateLatitude is number
        && data.approximateLatitude >= -90
        && data.approximateLatitude <= 90
        && data.approximateLongitude is number
        && data.approximateLongitude >= -180
        && data.approximateLongitude <= 180;
    }

    match /users/{userId} {
      allow create: if isOwner(userId)
        && validUserProfile(request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow read, delete: if isOwner(userId);

      allow update: if isOwner(userId)
        && validUserProfile(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['nickname', 'updatedAt']);
    }

    match /pairs/{pairId} {
      // resource == null: 새 초대 코드 중복 확인용(없는 문서 조회) 허용
      allow get: if signedIn()
        && (resource == null
          || request.auth.uid in resource.data.memberIds
          || resource.data.status == 'waiting');

      allow list: if signedIn()
        && request.auth.uid in resource.data.memberIds;

      allow create: if signedIn()
        && validPair(request.resource.data)
        && request.resource.data.creatorId == request.auth.uid
        && request.resource.data.memberIds == [request.auth.uid]
        && request.resource.data.status == 'waiting'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if isInviteAcceptance()
        || isMemberPairUpdate(pairId);

      allow delete: if false;

      match /members/{userId} {
        allow read: if isOpenPairMember(pairId);

        allow create, update: if isOpenPairMember(pairId)
          && isOwner(userId)
          && validPairMember(request.resource.data)
          && request.resource.data.updatedAt == request.time;

        allow delete: if isPairMember(pairId) && isOwner(userId);

        match /visits/{visitId} {
          allow read: if isOpenPairMember(pairId);

          allow create, update: if isOpenPairMember(pairId)
            && isOwner(userId)
            && visitId.matches('^[0-9a-f]{64}$')
            && validSharedVisit(request.resource.data);

          allow delete: if isPairMember(pairId) && isOwner(userId);
        }
      }

      match /results/{resultId} {
        allow read: if isOpenPairMember(pairId);

        // 이전 버전 앱이 새 점수 스키마 결과를 낮은 버전으로 덮어쓰지 못하게 합니다.
        allow create, update: if isOpenPairMember(pairId)
          && resultId == 'current'
          && validMatchResult(request.resource.data)
          && request.resource.data.createdAt == request.time
          && (resource == null
            || request.resource.data.schemaVersion >= resource.data.schemaVersion);

        allow delete: if isOpenPairMember(pairId);
      }
    }

    // 두 사용자 사이의 잠금 문서. ID는 정렬된 두 uid를 '_'로 이은 값입니다.
    // 이미 활성 연결을 가리키는 잠금 문서는 다른 페어로 바꿀 수 없어서,
    // 같은 두 사람 사이에 활성 연결이 둘 생기지 않습니다.
    function pairLinkKey(firstUserId, secondUserId) {
      return firstUserId < secondUserId
        ? firstUserId + '_' + secondUserId
        : secondUserId + '_' + firstUserId;
    }

    function validPairLink(linkId) {
      let data = request.resource.data;
      let pair = getAfter(/databases/$(database)/documents/pairs/$(data.pairId)).data;
      return signedIn()
        && data.keys().hasAll(['memberIds', 'pairId', 'updatedAt'])
        && data.keys().hasOnly(['memberIds', 'pairId', 'updatedAt'])
        && data.memberIds is list
        && data.memberIds.size() == 2
        && data.memberIds[0] != data.memberIds[1]
        && request.auth.uid in data.memberIds
        && linkId == pairLinkKey(data.memberIds[0], data.memberIds[1])
        && data.pairId is string
        && data.updatedAt == request.time
        && pair.status == 'active'
        && pair.memberIds.hasAll(data.memberIds);
    }

    match /pairLinks/{linkId} {
      // 문서가 없을 때도 트랜잭션에서 조회할 수 있어야 하므로 ID에 내 uid가 있는지로 판단합니다.
      allow get: if signedIn() && request.auth.uid in linkId.split('_');

      allow create: if validPairLink(linkId);

      // 같은 페어를 다시 쓰거나, 이전에 가리키던 연결이 끝난 경우에만 새 페어로 바꿀 수 있습니다.
      allow update: if validPairLink(linkId)
        && (resource.data.pairId == request.resource.data.pairId
          || get(/databases/$(database)/documents/pairs/$(resource.data.pairId)).data.status == 'ended');

      allow list, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
